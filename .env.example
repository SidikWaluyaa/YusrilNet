# Application
APP_NAME="YusrilNet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

# Locale
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sidiknet
DB_USERNAME=root
DB_PASSWORD=

# Broadcasting & Cache
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# iPaymu Payment Gateway Configuration
# ==========================================

# SANDBOX MODE (Development/Testing)
# Set to true for testing, false for production
IPAYMU_SANDBOX=true

# SANDBOX CREDENTIALS (for testing)
# Get these from: https://sandbox.ipaymu.com
IPAYMU_SANDBOX_VA=your_sandbox_va_here
IPAYMU_SANDBOX_API_KEY=your_sandbox_api_key_here

# PRODUCTION CREDENTIALS (for live)
# Get these from: https://my.ipaymu.com
IPAYMU_PRODUCTION_VA=your_production_va_here
IPAYMU_PRODUCTION_API_KEY=your_production_api_key_here

# ACTIVE CREDENTIALS (will be auto-selected based on IPAYMU_SANDBOX)
# For backward compatibility - will use sandbox or production based on mode
IPAYMU_VA=${IPAYMU_SANDBOX_VA}
IPAYMU_API_KEY=${IPAYMU_SANDBOX_API_KEY}

# ==========================================
# DEPLOYMENT NOTES:
# ==========================================
# 
# FOR LOCALHOST/DEVELOPMENT:
# - Set IPAYMU_SANDBOX=true
# - Use IPAYMU_SANDBOX_VA and IPAYMU_SANDBOX_API_KEY
# - Callback won't work (use testing dashboard)
# - Access testing: http://localhost:8000/test/payment-dashboard
#
# FOR PRODUCTION/HOSTING:
# - Set APP_ENV=production
# - Set APP_DEBUG=false
# - Set IPAYMU_SANDBOX=false
# - Use IPAYMU_PRODUCTION_VA and IPAYMU_PRODUCTION_API_KEY
# - Update IPAYMU_VA and IPAYMU_API_KEY to production values
# - Ensure callback URL is accessible from internet
# - Remove or disable testing routes
#
# ==========================================

# Vite (for asset compilation)
VITE_APP_NAME="${APP_NAME}"
